{% set attributes = attributes|default(create_attribute()) %}
{# Approved icon set, copied from sample-input.html. #}
{% set icon_paths = {
  document: '<path d="M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2z"/><path d="M9 8h6M9 12h6"/>',
  heart: '<path d="M12 21c-5-3-8-6-8-10a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 4-3 7-8 10z"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  clock: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2M9 2h6"/>',
} %}
<div{{ attributes.addClass('benefit') }}>
  <div class="icon" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">{{ (icon_paths[icon] ?? icon_paths.document)|raw }}</svg>
  </div>
  <h3>{{ title }}</h3>
  {% if text %}
    <p>{{ text }}</p>
  {% endif %}
</div>
