                    "heading": "Frequently asked questions",
                    "anchor_id": "faq"
                },
                "slots": {
                    "items": [
                        {
                            "component_id": "sdc.galvus_ds.faq_item",
                            "uuid": "6d04d6a0-0c92-486e-8b28-3efbc044ce3d",
                            "inputs": {
                                "question": "What is Galvus used for?",
                                "answer": "Galvus is a prescription medicine used with diet and exercise in adults with type 2 diabetes. Your doctor will decide if it is right for you."
                            }
                        },
                        {
                            "component_id": "sdc.galvus_ds.faq_item",
                            "uuid": "87ac44aa-7c01-44cb-9643-848ebc1c90bc",
                            "inputs": {
                                "question": "How should I take my medicine?",
                                "answer": "Always take your medicine exactly as your doctor or pharmacist has told you. If you are unsure, ask them."
                            }
                        },
                        {
                            "component_id": "sdc.galvus_ds.faq_item",
                            "uuid": "cad7afe8-b1e5-41d0-8a45-cfe87b1ef788",
                            "inputs": {
                                "question": "What should I do if I miss a dose?",
                                "answer": "Follow the instructions in your patient leaflet and speak to your doctor or pharmacist if you are not sure what to do."
                            }
                        },
                        {
                            "component_id": "sdc.galvus_ds.faq_item",
                            "uuid": "37f64916-90db-44bb-bc8d-5ae0dec10e13",
                            "inputs": {
                                "question": "Can I stop taking it when I feel better?",
                                "answer": "Do not stop or change your treatment without talking to your doctor first."
                            }
                        },
                        {
                            "component_id": "sdc.galvus_ds.faq_item",
                            "uuid": "265c919d-727d-4f8c-ac45-6526a5708660",
                            "inputs": {
                                "question": "Where can I report side effects?",
                                "answer": "Talk to your doctor or pharmacist about any side effect. You can also report them through your national reporting system."
                            }
                        }
                    ]
                }
